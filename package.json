{
  "name": "dsh-voice-input",
  "version": "0.2.3",
  "description": "Offline local speech-to-text for the DeepSeek Harness composer: a microphone button that records, transcribes on your own machine (GPU via whisper.cpp/Vulkan where available), streams the text into the chat draft, and keeps the model resident between recordings.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "voice",
    "speech-to-text",
    "whisper",
    "whisper.cpp",
    "vulkan",
    "offline"
  ],
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./python/worker.py": "./python/worker.py",
    "./python/transcribe.py": "./python/transcribe.py",
    "./python/setup.py": "./python/setup.py",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.cjs",
    "lib/engine.mjs",
    "cordis.patch.yml",
    "python/worker.py",
    "python/transcribe.py",
    "python/setup.py",
    "engine/bin/whisper-server.exe",
    "engine/LICENSE-whisper.cpp.txt",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/contract.test.mjs tests/client-styles.test.mjs",
    "check:browser": "node tools/cdp-check.mjs"
  }
}
